# Copy this file to .env and load it into your shell. Never commit a real key.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Cost-conscious defaults. All values are optional except the API key.
MACRO_SAGE_MODEL=gpt-5.6-luna
MACRO_SAGE_MODEL_FALLBACKS=gpt-5.6-terra,gpt-4.1-mini
MACRO_SAGE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MACRO_SAGE_TRANSCRIPTION_MODEL_FALLBACKS=whisper-1
MACRO_SAGE_REASONING_EFFORT=low
MACRO_SAGE_MAX_ARTICLES=30
MACRO_SAGE_MAX_ARTICLE_CHARS=40000
MACRO_SAGE_MAX_CORPUS_CHARS=350000
MACRO_SAGE_MAX_PODCAST_EPISODES=6
MACRO_SAGE_MAX_PODCAST_MINUTES=240
MACRO_SAGE_SYNTHESIS_TIMEOUT_SECONDS=180
MACRO_SAGE_TIMEZONE=Europe/Amsterdam

# Optional Telegram delivery. Keep the token secret; the chat ID may be an
# @channel username or the numeric ID of a private channel.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=@replace-with-channel
# Optional numeric private chat ID. The admin must first send /start to the bot.
# TELEGRAM_ADMIN_CHAT_ID=123456789
